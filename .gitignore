# === Nix / NixOS / Flakes ===
# Menyembunyikan folder hasil build (jika Anda pernah mengetik nix build)
result
result-*

# === Config Hardware Per-Device ===
# Hasil dari `nixos-generate-config`, dibuat di tiap mesin target.
# JANGAN di-commit — flake.nix tetap meng-import-nya saat evaluasi.
hardware-configuration.nix

# === File Rahasia / Sensitif (Opsional tapi Penting) ===
# Jika suatu hari Anda menyimpan password atau token API di file terpisah
*.secret
*.env
secret.nix
secrets/

# === Backup & File Sementara ===
# File sementara yang dibuat oleh teks editor seperti Nano atau Vim saat mengedit
*.swp
*~
.nix-*.bak

# === System & OS Trash ===
# Menyembunyikan file sampah otomatis dari sistem operasi / file manager
.DS_Store
Thumbs.db
